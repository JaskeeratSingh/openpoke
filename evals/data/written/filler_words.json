{
  "_about": "Filler agents compete with the real ones: each belongs to one of the real agents' categories (emails, invoices, travel, ...) and is named the same way. But every filler is about different people, companies, places and IDs, so it never holds a fact a case needs. {first}/{last}/... are filled in by build_dataset.py.",

  "categories": [
    {"category": "email",
     "names": ["Email to {first}", "{first} Follow-up", "Reply to {first}", "Note for {first}"],
     "user": "email {first} about {topic}",
     "result": "Emailed {first} {last} ({relation}) about {topic}.",
     "card": {"purpose": "Emailing {first} about {topic}.", "people": "{first} {last}, {relation}.", "details": "About {topic}.", "state": "Waiting for a reply."},
     "key_terms": ["{first} {last}"]},

    {"category": "invoice",
     "names": ["Invoice Chase {company}", "{company} Invoice", "Payment from {company}", "{company} Payment Reminder"],
     "user": "{company} still owes us for invoice {invoice}, can you chase {first}",
     "result": "Emailed {first} {last} ({company} billing) about invoice {invoice} for ${amount}.",
     "card": {"purpose": "Chasing payment of invoice {invoice} from {company}.", "people": "{first} {last}, billing contact at {company}.", "details": "Invoice {invoice}, ${amount}.", "state": "Waiting for payment."},
     "key_terms": ["{first} {last}", "{invoice}", "{company}"]},

    {"category": "travel",
     "names": ["Flights to {city}", "{city} Trip", "{city} Hotel", "Train to {city}"],
